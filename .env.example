# Copy to .env for local runs. Never commit real values.

# API token of the Hetzner Cloud project (required). HCLOUD_TOKEN is accepted as an alias;
# set only one of them.
HETZNER_TOKEN=<api-token>

# API base URL (default: https://api.hetzner.cloud/v1). https is required, http only for localhost.
# The token is sent to this host. Do not put credentials into the URL.
# HETZNER_API_URL=https://api.hetzner.cloud/v1

# Name of the project in log lines (default: default)
# HETZNER_MCP_PROJECT_NAME=default

# Safety controls
# Only register read-only tools (default: false)
# HETZNER_MCP_READ_ONLY=true
# Destructive and cost-incurring tools need confirm: true (default: true)
# HETZNER_MCP_REQUIRE_CONFIRMATION=true
# Changes are limited to resources carrying all of these labels, key=value, comma-separated (default: off)
# HETZNER_MCP_LABEL_SCOPE=env=staging
# Resources with an infrastructure-as-code label: off | warn | block (default: warn)
# HETZNER_MCP_IAC_POLICY=warn
# Labels that mark a resource as managed by infrastructure code (default: managed-by=terraform,managed_by=terraform)
# HETZNER_MCP_IAC_LABELS=managed-by=terraform,managed_by=terraform

# Cost controls (limits of this server, not of the token)
# false removes the tools that can start or raise recurring costs (default: true)
# HETZNER_MCP_ALLOW_COSTS=false
# Reject a single call whose added net monthly cost is above this amount, in the currency of /pricing (default: off)
# HETZNER_MCP_MAX_MONTHLY_COST=5.00

# Enabled toolsets, comma-separated or "all" (default: core,info,actions,ssh_keys)
# Available: core, info, actions, ssh_keys, firewalls, storage
# HETZNER_MCP_TOOLSETS=core,info,actions,ssh_keys

# TCP ports covered by the firewall lock-out warning, at most 10 (default: 22)
# HETZNER_MCP_FIREWALL_GUARD_PORTS=22

# HTTP timeout per request in milliseconds, 1000 to 300000 (default: 30000)
# HETZNER_MCP_TIMEOUT_MS=30000
# How long a tool waits for Hetzner actions in milliseconds, 0 to 600000 (default: 50000)
# HETZNER_MCP_ACTION_WAIT_MS=50000

# Log level on stderr: debug | info | warn | error (default: info)
# HETZNER_MCP_LOG_LEVEL=info
